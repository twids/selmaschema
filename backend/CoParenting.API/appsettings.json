{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Oidc": {
    "CallbackPath": "/signin-oidc"
  },
  "AdminOidc": {
    "CallbackPath": "/signin-oidc-admin",
    "RequiredGroup": "selma-platform-admins"
  },
  "Auth": {
    "BreakGlass": {
      "Enabled": false
    }
  },
  "Database": {
    "ApplyMigrations": false,
    "AllowDestructiveV2Reset": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=db;Database=CoParentingCalendar;Username=postgres;Password=YourStrong@Passw0rd"
  }
}
